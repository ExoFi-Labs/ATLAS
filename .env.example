# =============================================================================
# ATLAS configuration — copy to .env and adjust per environment
# See deploy/profiles/home.env.example and deploy/profiles/work.env.example
# =============================================================================

# --- Application ---
ATLAS_ENV=development
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8080
ATLAS_LOG_LEVEL=info
ATLAS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Auth (swap provider without code changes) ---
# dev | oidc (oidc stub ready for Azure AD / Okta later)
ATLAS_AUTH__PROVIDER=dev
ATLAS_AUTH__DEV_USER_ID=dev-user
ATLAS_AUTH__DEV_ROLES=all-staff,admin
# OIDC (leave blank until work migration)
ATLAS_AUTH__OIDC_ISSUER=
ATLAS_AUTH__OIDC_CLIENT_ID=
ATLAS_AUTH__OIDC_CLIENT_SECRET=
ATLAS_AUTH__OIDC_REDIRECT_URI=

# --- LLM (ollama at home, vllm at work — same OpenAI-compatible client) ---
# Provider label is informational; both use ATLAS_LLM__BASE_URL + MODEL
ATLAS_LLM__PROVIDER=ollama
ATLAS_LLM__BASE_URL=http://127.0.0.1:11434/v1
ATLAS_LLM__MODEL=phi3:latest
ATLAS_LLM__API_KEY=ollama
ATLAS_LLM__MAX_TOKENS=1024
ATLAS_LLM__TEMPERATURE=0.2

# --- Embeddings ---
ATLAS_EMBEDDINGS__PROVIDER=sentence_transformers
ATLAS_EMBEDDINGS__MODEL=BAAI/bge-small-en-v1.5
ATLAS_EMBEDDINGS__DEVICE=cpu

# --- Vector store ---
ATLAS_VECTOR__PROVIDER=qdrant
ATLAS_VECTOR__URL=http://127.0.0.1:6333
# Embedded Qdrant — no Docker needed. Leave empty to use ATLAS_VECTOR__URL instead.
ATLAS_VECTOR__PATH=./data/qdrant
ATLAS_VECTOR__COLLECTION=atlas_email_chunks

# --- RAG ---
ATLAS_RAG__TOP_K=20
ATLAS_RAG__TOP_N=5
ATLAS_RAG__MIN_SCORE=0.35

# --- TTS (google | none) ---
ATLAS_TTS__PROVIDER=google
ATLAS_TTS__GOOGLE_VOICE=en-US-Neural2-J
ATLAS_TTS__GOOGLE_LANGUAGE=en-US
# Path to GCP service account JSON, or use GOOGLE_APPLICATION_CREDENTIALS
ATLAS_TTS__GOOGLE_CREDENTIALS_FILE=

# --- STT (whisper | none) ---
ATLAS_STT__PROVIDER=whisper
ATLAS_STT__WHISPER_MODEL=base
ATLAS_STT__WHISPER_DEVICE=cpu

# --- Ingestion ---
ATLAS_INGESTION__DEFAULT_ROLES=all-staff
ATLAS_INGESTION__DEFAULT_DEPARTMENT=general
ATLAS_INGESTION__MAX_CHUNK_TOKENS=1200

# --- Postgres (metadata, audit — optional for later) ---
ATLAS_DATABASE__URL=postgresql+asyncpg://atlas:atlas@postgres:5432/atlas
