# Work production profile — copy values into .env after git clone on server
ATLAS_ENV=production
ATLAS_AUTH__PROVIDER=oidc
ATLAS_AUTH__OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
ATLAS_AUTH__OIDC_CLIENT_ID=
ATLAS_AUTH__OIDC_CLIENT_SECRET=
ATLAS_AUTH__OIDC_REDIRECT_URI=https://atlas.company.internal/auth/callback

ATLAS_LLM__PROVIDER=vllm
ATLAS_LLM__BASE_URL=http://vllm:8000/v1
ATLAS_LLM__MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-AWQ
ATLAS_LLM__API_KEY=not-needed

ATLAS_EMBEDDINGS__DEVICE=cuda
ATLAS_STT__WHISPER_DEVICE=cuda

ATLAS_TTS__PROVIDER=google
ATLAS_TTS__GOOGLE_CREDENTIALS_FILE=/run/secrets/gcp-tts.json
